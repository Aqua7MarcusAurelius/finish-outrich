# ───────────────────────────────
# Приложение
# ───────────────────────────────
APP_ENV=development
APP_PORT=8000
API_TOKEN=change_me_to_random_string
DOCS_PUBLIC=true

# ───────────────────────────────
# CORS
# ───────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ───────────────────────────────
# PostgreSQL
# ───────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tgframework
POSTGRES_USER=tgframework
POSTGRES_PASSWORD=change_me

# ───────────────────────────────
# Redis
# ───────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ───────────────────────────────
# MinIO
# ───────────────────────────────
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=tgframework
# Отдельный бакет для HTML-отчётов автодиалогов (finished_by_llm).
MINIO_REPORTS_BUCKET=autochat-reports

# ───────────────────────────────
# OpenRouter
# ───────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL_TRANSCRIPTION=openai/whisper
OPENROUTER_MODEL_DESCRIPTION=openai/gpt-4o
# Для документов (PDF и др.) — модель с нативной поддержкой файлов.
OPENROUTER_MODEL_DESCRIPTION_DOCUMENTS=google/gemini-2.5-flash
# Для автодиалогов (модуль AutoChat). Уточнить точное имя Opus 4.7
# на https://openrouter.ai/models — меняется только здесь.
OPENROUTER_MODEL_AUTOCHAT=anthropic/claude-opus-4.7
# Для оценщика лидов (модуль lead_evaluator) — закрывает диалог и
# извлекает имя/возраст/город/работу/интересы. Дефолт — тот же Opus 4.7.
OPENROUTER_MODEL_EVALUATOR=anthropic/claude-opus-4.7

# Telegram API (получить на https://my.telegram.org — один раз для всего приложения)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ───────────────────────────────
# CRM коллеги (для scripts/crm_probe.py — разведка перед интеграцией)
# ───────────────────────────────
CRM_BASE_URL=
CRM_API_TOKEN=

# ───────────────────────────────
# Доставка success-отчётов в TG-группы (report_delivery, этап 10.20)
# ───────────────────────────────
# Сервисный аккаунт (accounts.name), который состоит в группах выгрузки и
# заливает туда HTML-отчёты по удачным диалогам. Скрыт из UI.
SERVICE_ACCOUNT_NAME=service
# Карта «семейство воркера → chat_id группы», JSON. Ключ = префикс имени
# воркера до '_' (SAD_03_RU → SAD), регистр любой; одна группа на всё
# семейство. Значение = числовой id группы. Пусто = доставка выключена.
# REPORT_GROUP_MAP={"SAD": -1001234567890, "JOKER": -1009876543210}
REPORT_GROUP_MAP=